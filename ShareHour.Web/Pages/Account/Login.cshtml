@page
@model ShareHour.Web.Pages.Account.LoginModel
@{ ViewData["Title"] = "Sign in"; }
<h1>Sign in</h1><div class="row"><div class="col-md-6 col-lg-5"><form method="post" class="card p-4 shadow-sm">
<div asp-validation-summary="All" class="text-danger"></div>
<div class="mb-3"><label class="form-label" asp-for="Input.Email"></label><input class="form-control" asp-for="Input.Email"/><span asp-validation-for="Input.Email" class="text-danger"></span></div>
<div class="mb-3"><label class="form-label" asp-for="Input.Password"></label><input type="password" class="form-control" asp-for="Input.Password"/><span asp-validation-for="Input.Password" class="text-danger"></span></div>
<button class="btn btn-dark">Sign in</button></form>
<div class="alert alert-light border mt-3"><strong>Classroom demo accounts:</strong><br/>Owner: owner@sharehour.test<br/>Renter: renter@sharehour.test<br/>Password for both: Demo123!</div>
</div></div>
