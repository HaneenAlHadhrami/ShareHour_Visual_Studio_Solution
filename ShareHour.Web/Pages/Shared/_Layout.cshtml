@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | Share Hour</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<header class="site-header">
  <nav class="container navbar navbar-expand-lg d-flex flex-wrap align-items-center gap-3 py-3">
    <a class="brand" asp-page="/Index">◷ Share Hour</a>
    <a class="nav-link" asp-page="/Index">Explore</a>
    <a class="nav-link" asp-page="/Tools/Index">Tools</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
      <a class="nav-link" asp-page="/Bookings/Index">My bookings</a>
      @if (User.IsInRole("Owner"))
      {
        <a class="nav-link" asp-page="/Tools/Create">List a tool</a>
        <a class="nav-link" asp-page="/Bookings/Review">Owner requests</a>
      }
      <span class="ms-auto small">@User.Identity.Name</span>
      <form method="post" asp-page="/Account/Logout"><button class="btn btn-outline-light btn-sm" type="submit">Sign out</button></form>
    }
    else
    {
      <a class="nav-link ms-auto" asp-page="/Account/Login">Sign in</a>
      <a class="btn btn-warning btn-sm" asp-page="/Account/Register">Register</a>
    }
  </nav>
</header>
<main class="container my-4 min-height-content">
  @if (TempData["Notice"] is string notice) { <div class="alert alert-info" role="status">@notice</div> }
  @RenderBody()
</main>
<footer class="footer"><div class="container py-3">Share Hour · COMP4701 · SQU · Educational prototype</div></footer>
<script src="~/lib/jquery/jquery.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("PageScripts", required: false)
</body></html>
