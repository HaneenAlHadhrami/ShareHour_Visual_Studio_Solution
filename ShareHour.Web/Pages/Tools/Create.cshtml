@page
@model ShareHour.Web.Pages.Tools.CreateModel
@{ ViewData["Title"] = "List a tool"; }
<h1>List a tool</h1><p class="text-secondary">Provide tool information for renters.</p>
<form method="post" class="card p-4 col-lg-8 shadow-sm" novalidate>
 <div asp-validation-summary="ModelOnly" class="text-danger"></div>
 <div class="mb-3"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name" class="form-control" /><span asp-validation-for="Input.Name" class="text-danger"></span></div>
 <div class="mb-3"><label asp-for="Input.Description" class="form-label"></label><textarea asp-for="Input.Description" class="form-control" rows="3"></textarea><span asp-validation-for="Input.Description" class="text-danger"></span></div>
 <div class="mb-3"><label asp-for="Input.Category" class="form-label"></label><select asp-for="Input.Category" asp-items="Html.GetEnumSelectList<ToolCategory>()" class="form-select"></select></div>
 <div class="mb-3"><label asp-for="Input.HourlyPrice" class="form-label">Price per hour (OMR)</label><input asp-for="Input.HourlyPrice" type="number" step="0.001" min="0.1" class="form-control" /><span asp-validation-for="Input.HourlyPrice" class="text-danger"></span></div>
 <div class="form-check mb-3"><input asp-for="Input.IsActive" class="form-check-input" /><label asp-for="Input.IsActive" class="form-check-label">Available for rental</label></div>
 <button class="btn btn-dark" type="submit">Publish tool</button>
</form>
